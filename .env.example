# 이 파일을 .env로 복사해 값을 채운다. .env는 저장소에 올리지 않는다.
DB_URL=jdbc:mysql://localhost:3306/blog?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=blog
DB_PASSWORD=blog

# Gmail 주소와 앱 비밀번호 (Google 계정 > 보안 > 앱 비밀번호)
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT 서명 키. 32바이트 이상 무작위 값 (예: openssl rand -base64 48)
JWT_SECRET=
# Access Token 유효 시간 (기본 15m)
# JWT_ACCESS_TOKEN_TTL=15m

# 인증번호·토큰·블랙리스트 해시용 비밀값. 32바이트 이상 무작위 값, 운영 중에는 바꾸지 않는다
# local 프로필은 비워 두면 개발용 기본값을 쓴다
HASH_SECRET=

# Cloudflare Turnstile 키 (SEC-13)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

BLOG_LIMIT_PUBLIC=3
STORAGE_LOCAL_DIR=./uploads

# 실행 환경 (OPS-11). ./gradlew bootRun은 local로 뜬다. 운영 서버는 이 파일이 아니라
# 서버 환경변수로 SPRING_PROFILES_ACTIVE=prod를 준다. prod에서는 JWT_SECRET, DB_PASSWORD,
# MAIL_PASSWORD, TURNSTILE_SECRET_KEY가 비었거나 예시 값이면 서버가 뜨지 않는다

# 로그 파일 위치 (local·test가 아니면 날짜별 파일, 30일 보관, OPS-03)
# LOG_PATH=./logs
